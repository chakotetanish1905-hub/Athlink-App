{
  "name": "athlink-rules-tests",
  "private": true,
  "description": "Firestore + Storage security rules tests for Athlink (run against the Firebase emulators).",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 rules.test.mjs",
    "emulators:test": "firebase emulators:exec --project demo-athlink --only firestore,storage --config ../../firebase.json \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "firebase": "11.10.0",
    "firebase-tools": "14.11.0"
  }
}
