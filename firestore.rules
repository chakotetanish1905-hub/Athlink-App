rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Athlink Firestore security rules.
//
// Replaces the development rule `allow read, write: if request.auth != null`.
//
// Core principle: ROLE ≠ VERIFICATION. `users/{uid}.role == ORGANISATION` grants no trust.
// Organisation trust (verificationStatus / verificationLevel on organisations/{id}) can only be
// raised by an admin through the Admin SDK (tools/admin), which bypasses these rules.
// The app can make exactly two status moves, both checked here:
//   UNVERIFIED -> CONTACT_VERIFIED              (needs request.auth.token.email_verified)
//   editable   -> UNDER_REVIEW (submit)          (needs email_verified)
//
// Mirrors: OrganisationVerificationPolicy.kt / CoachVerificationPolicy.kt / tools/admin/policy.js,
//          PlayerValidators.kt / PlayerProfileForm.kt (player profile limits).
// Tests:   tests/rules/rules.test.mjs
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    function emailVerified() { return signedIn() && request.auth.token.get('email_verified', false) == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function unchanged(keys) { return !changedKeys().hasAny(keys); }
    function path(col, id) { return /databases/$(database)/documents/$(col)/$(id); }

    function roleAfter(uid) { return getAfter(path('users', uid)).data.role; }
    function roleOf(uid) { return get(path('users', uid)).data.role; }
    function isOrganisationAccount() {
      return signedIn() && exists(path('users', request.auth.uid)) && roleOf(request.auth.uid) == 'ORGANISATION';
    }

    // ── Organisation status helpers ──────────────────────────────────────────
    function trustedStatuses() { return ['VERIFIED', 'OFFICIAL_GOVERNMENT']; }
    function editableStatuses() { return ['UNVERIFIED', 'CONTACT_VERIFIED', 'REJECTED', 'EXPIRED']; }
    function allStatuses() {
      return ['UNVERIFIED', 'CONTACT_VERIFIED', 'UNDER_REVIEW', 'VERIFIED', 'OFFICIAL_GOVERNMENT', 'REJECTED', 'SUSPENDED', 'EXPIRED'];
    }
    function expiredByDate(o) {
      return o.get('verificationExpiresAt', null) != null && o.verificationExpiresAt <= request.time;
    }
    // Owner may edit evidence / submit: editable status, or a trusted status past its expiry date.
    function orgEditableData(o) {
      return o.verificationStatus in editableStatuses()
        || (o.verificationStatus in trustedStatuses() && expiredByDate(o));
    }
    function orgEditable(orgId) {
      return exists(path('organisations', orgId)) && orgEditableData(get(path('organisations', orgId)).data);
    }
    function orgEditableAfter(orgId) {
      return existsAfter(path('organisations', orgId)) && orgEditableData(getAfter(path('organisations', orgId)).data);
    }
    function orgCanPublishData(o) {
      return o.verificationStatus in trustedStatuses()
        && o.verificationLevel in ['LEVEL_2_ORGANISATION_VERIFIED', 'LEVEL_3_OFFICIAL_GOVERNMENT']
        && !expiredByDate(o);
    }
    function orgNotSuspended(orgId) {
      return !exists(path('organisations', orgId))
        || get(path('organisations', orgId)).data.verificationStatus != 'SUSPENDED';
    }

    // ── Admin: read-only access to everything for review tooling. Admin WRITES go through the
    //    Admin SDK (server-side), never through client rules. ────────────────────────────────
    match /{document=**} {
      allow read: if isAdmin();
    }

    // ═════════════════════════════════════════════════════════════════════════
    // users/{uid}: shared account record. Role is fixed at signup.
    // ═════════════════════════════════════════════════════════════════════════
    // Private account fields (date of birth, phone, gender, consents, notification preferences) live
    // here because this document is owner-only. A password is never stored in Firestore.
    function validUserData(d) {
      return !d.keys().hasAny(['password', 'confirmPassword'])
        && d.get('dateOfBirth', '') is string
        && (d.get('dateOfBirth', '') == '' || d.get('dateOfBirth', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && d.get('phoneNumber', '') is string && d.get('phoneNumber', '').size() <= 20
        && d.get('gender', '') in ['', 'MALE', 'FEMALE', 'NON_BINARY', 'PREFER_NOT_TO_SAY']
        && d.get('profileStatus', '') in ['', 'INCOMPLETE', 'COMPLETE']
        && d.get('notificationPreferences', {}) is map;
    }
    // Consent timestamps can only be stamped once, with the server time.
    function consentStampOk(key) {
      return unchanged([key])
        || (existing().get(key, null) == null && incoming().get(key, null) == request.time);
    }
    // A PLAYER profile can only be COMPLETE together with its public players/{uid} document and
    // recorded consent (the app writes all of it in one batch).
    function playerCompleteOk(uid, d) {
      return d.role != 'PLAYER'
        || d.get('profileStatus', '') != 'COMPLETE'
        || (existsAfter(path('players', uid))
            && d.get('termsAcceptedAt', null) != null
            && d.get('privacyAcceptedAt', null) != null);
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && incoming().uid == uid
        && incoming().role in ['PLAYER', 'COACH', 'ORGANISATION']
        && (incoming().get('organisationId', '') == ''
            || (incoming().role == 'ORGANISATION' && incoming().organisationId == uid))
        && validUserData(incoming())
        && incoming().get('profileStatus', '') != 'COMPLETE'
        // Player signup requires Terms + Privacy consent, stamped with the server time.
        && (incoming().role != 'PLAYER'
            || (incoming().get('termsAcceptedAt', null) == request.time
                && incoming().get('privacyAcceptedAt', null) == request.time));
      allow update: if isSelf(uid)
        && unchanged(['uid', 'role', 'createdAt'])
        && (unchanged(['organisationId'])
            || (existing().role == 'ORGANISATION'
                && existing().get('organisationId', '') == ''
                && incoming().organisationId == uid))
        && validUserData(incoming())
        && consentStampOk('termsAcceptedAt')
        && consentStampOk('privacyAcceptedAt')
        // Date of birth is fixed once the profile is complete (minor safety); support corrects it.
        && (unchanged(['dateOfBirth']) || existing().get('profileStatus', '') != 'COMPLETE')
        && playerCompleteOk(uid, incoming());
      allow delete: if false;
    }

    // ═════════════════════════════════════════════════════════════════════════
    // PLAYERS: public player profile (discoverable by signed-in users, e.g. coaches).
    // Private account data must never appear here.
    // ═════════════════════════════════════════════════════════════════════════
    function validPlayerPublic(d) {
      return d.uid is string
        && !d.keys().hasAny(['email', 'dateOfBirth', 'phoneNumber', 'gender', 'password', 'role',
                             'termsAcceptedAt', 'privacyAcceptedAt', 'notificationPreferences', 'profileStatus'])
        && d.get('displayName', '') is string && d.get('displayName', '').size() <= 60
        // Photo is a small data: URI (Spark plan) or a URL; keep the public document light.
        && d.get('photoUrl', '') is string && d.get('photoUrl', '').size() <= 150000
        && d.get('country', '') is string && d.get('country', '').size() <= 80
        && d.get('state', '') is string && d.get('state', '').size() <= 80
        && d.get('city', '') is string && d.get('city', '').size() <= 60
        && d.get('region', '') is string && d.get('region', '').size() <= 40
        && d.get('areaType', '') in ['', 'METRO', 'TIER_2', 'TIER_3', 'RURAL']
        && d.get('primarySport', '') is string && d.get('primarySport', '').size() <= 40
        && d.get('secondarySports', []) is list && d.get('secondarySports', []).size() <= 5
        && d.get('sportProfile', {}) is map && d.get('sportProfile', {}).size() <= 10
        && d.get('skillLevel', '') in ['', 'BEGINNER', 'INTERMEDIATE', 'ADVANCED', 'COMPETITIVE', 'PROFESSIONAL']
        && d.get('goals', []) is list && d.get('goals', []).size() <= 9
        && d.get('coachingPreferences', {}) is map
        && d.get('currentTeam', '') is string && d.get('currentTeam', '').size() <= 80
        && d.get('academy', '') is string && d.get('academy', '').size() <= 80
        && d.get('ranking', '') is string && d.get('ranking', '').size() <= 60
        && d.get('bio', '') is string && d.get('bio', '').size() <= 500
        && d.get('achievements', []) is list && d.get('achievements', []).size() <= 10;
    }

    match /players/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid)
        && roleAfter(uid) == 'PLAYER'
        && incoming().uid == uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && validPlayerPublic(incoming());
      allow update: if isSelf(uid)
        && roleAfter(uid) == 'PLAYER'
        && unchanged(['uid', 'createdAt'])
        && incoming().updatedAt == request.time
        && validPlayerPublic(incoming());
      allow delete: if false;
    }

    // ═════════════════════════════════════════════════════════════════════════
    // ORGANISATIONS
    // organisationId == owner uid (one organisation per account, impersonation-proof).
    // ═════════════════════════════════════════════════════════════════════════

    function validOrgPublic(d) {
      return d.organisationId is string && d.ownerUid is string
        && d.legalName is string && d.legalName.size() <= 120
        && d.displayName is string && d.displayName.size() <= 120
        && d.organisationType is string && d.organisationType.size() <= 40
        && d.sports is list && d.sports.size() <= 20
        && d.description is string && d.description.size() <= 600
        && d.website is string && d.website.size() <= 200
        && d.publicAddress is string && d.publicAddress.size() <= 150
        // Logo is a small data: URI (or URL); keep the public document light.
        && d.get('logoUrl', '') is string && d.get('logoUrl', '').size() <= 150000;
    }

    // Set only by the admin tool's `seed-directory` (pre-verified academies, ids "dir-*", no owner).
    // An organisation account can never mark itself a directory listing or set a rating.
    function directoryOnlyKeys() { return ['listingSource', 'googleRating', 'googleReviewCount', 'ratingSource']; }

    match /organisations/{orgId} {
      // Public profile: any signed-in user (players see who runs an event).
      allow read: if signedIn();

      allow create: if isSelf(orgId)
        && roleAfter(orgId) == 'ORGANISATION'
        && incoming().organisationId == orgId
        && incoming().ownerUid == orgId
        && incoming().verificationStatus == 'UNVERIFIED'
        && incoming().verificationLevel == 'LEVEL_0_UNVERIFIED'
        && incoming().verifiedAt == null
        && incoming().verificationExpiresAt == null
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && !incoming().keys().hasAny(directoryOnlyKeys())
        && validOrgPublic(incoming());

      allow update: if isSelf(orgId)
        && incoming().updatedAt == request.time
        && unchanged(['organisationId', 'ownerUid', 'createdAt', 'verifiedAt', 'verificationExpiresAt'])
        && unchanged(directoryOnlyKeys())
        && validOrgPublic(incoming())
        && (
          // (a) Profile edit, no status change. Identity / location fields are locked unless
          //     verification is editable; description, website and logo can always change.
          (unchanged(['verificationStatus', 'verificationLevel'])
            && (orgEditableData(existing())
                || changedKeys().hasOnly(['description', 'website', 'logoUrl', 'updatedAt'])))
          // (b) Contact verified: UNVERIFIED -> CONTACT_VERIFIED, level 1, token says email_verified.
          || (existing().verificationStatus == 'UNVERIFIED'
            && incoming().verificationStatus == 'CONTACT_VERIFIED'
            && incoming().verificationLevel == 'LEVEL_1_CONTACT_VERIFIED'
            && emailVerified()
            && changedKeys().hasOnly(['verificationStatus', 'verificationLevel', 'updatedAt']))
          // (c) Submit for review: editable -> UNDER_REVIEW, level 1, email verified, and the
          //     private verification record moves to UNDER_REVIEW in the same batch.
          || (orgEditableData(existing())
            && incoming().verificationStatus == 'UNDER_REVIEW'
            && incoming().verificationLevel == 'LEVEL_1_CONTACT_VERIFIED'
            && emailVerified()
            && getAfter(path('organisationVerification', orgId)).data.status == 'UNDER_REVIEW'
            && getAfter(path('organisationVerification', orgId)).data.submittedAt == request.time)
        );

      allow delete: if false;
    }

    // Private legal / contact evidence. Check flags, review fields and rejection reason: admin only.
    match /organisationVerification/{orgId} {
      allow read: if isSelf(orgId);

      allow create: if isSelf(orgId)
        && incoming().verificationId == orgId
        && incoming().organisationId == orgId
        && incoming().ownerUid == orgId
        && incoming().contactVerified == false
        && incoming().legalEntityVerified == false
        && incoming().representativeVerified == false
        && incoming().addressVerified == false
        && incoming().sportsCredentialVerified == false
        && incoming().status == 'UNVERIFIED'
        && incoming().verificationLevel == 'LEVEL_0_UNVERIFIED'
        && incoming().submittedAt == null
        && incoming().reviewedAt == null
        && incoming().reviewedBy == null
        && incoming().reviewNotes == null
        && incoming().rejectionReason == null
        && incoming().updatedAt == request.time
        && orgEditableAfter(orgId);

      allow update: if isSelf(orgId)
        && incoming().updatedAt == request.time
        && unchanged(['verificationId', 'organisationId', 'ownerUid',
                      'contactVerified', 'legalEntityVerified', 'representativeVerified',
                      'addressVerified', 'sportsCredentialVerified',
                      'reviewedAt', 'reviewedBy', 'reviewNotes', 'rejectionReason'])
        && orgEditable(orgId)
        && (
          unchanged(['status', 'verificationLevel', 'submittedAt'])
          // Status mirror may only follow the organisation document's (rule-checked) transition.
          || (incoming().status == getAfter(path('organisations', orgId)).data.verificationStatus
            && incoming().verificationLevel == getAfter(path('organisations', orgId)).data.verificationLevel
            && ((incoming().status == 'CONTACT_VERIFIED' && unchanged(['submittedAt']))
                || (incoming().status == 'UNDER_REVIEW' && incoming().submittedAt == request.time)))
        );

      allow delete: if false;
    }

    // Authorised representative (id == organisationId). verificationStatus is admin-only.
    match /organisationRepresentatives/{orgId} {
      allow read: if isSelf(orgId);
      allow create: if isSelf(orgId)
        && incoming().representativeId == orgId
        && incoming().organisationId == orgId
        && incoming().ownerUid == orgId
        && incoming().verificationStatus == 'PENDING_MANUAL_REVIEW'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().fullName is string && incoming().fullName.size() <= 80
        && orgEditableAfter(orgId);
      allow update: if isSelf(orgId)
        && unchanged(['representativeId', 'organisationId', 'ownerUid', 'verificationStatus', 'createdAt'])
        && incoming().updatedAt == request.time
        && incoming().fullName is string && incoming().fullName.size() <= 80
        && orgEditable(orgId);
      allow delete: if false;
    }

    // Sports affiliation / recognition claim (id == organisationId). verificationStatus admin-only.
    match /organisationAffiliations/{orgId} {
      allow read: if isSelf(orgId);
      allow create: if isSelf(orgId)
        && incoming().affiliationId == orgId
        && incoming().organisationId == orgId
        && incoming().ownerUid == orgId
        && incoming().verificationStatus == 'PENDING_MANUAL_REVIEW'
        && incoming().updatedAt == request.time
        && orgEditableAfter(orgId);
      allow update: if isSelf(orgId)
        && unchanged(['affiliationId', 'organisationId', 'ownerUid', 'verificationStatus'])
        && incoming().updatedAt == request.time
        && orgEditable(orgId);
      allow delete: if false;
    }

    // Document metadata. The file is private in Storage. Review fields are admin-only.
    match /organisationDocuments/{documentId} {
      function documentTypes() {
        return ['REGISTRATION_CERTIFICATE', 'INCORPORATION_CERTIFICATE', 'PAN_DOCUMENT', 'GST_DOCUMENT',
                'ADDRESS_PROOF', 'AUTHORIZATION_LETTER', 'GOVERNMENT_ORDER', 'SPORTS_AFFILIATION',
                'SPORTS_LICENSE', 'ACCREDITATION', 'SPORTS_RECOGNITION', 'OTHER_SUPPORTING_DOCUMENT'];
      }
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && incoming().documentId == documentId
        && incoming().ownerUid == request.auth.uid
        && incoming().organisationId == request.auth.uid
        && incoming().documentType in documentTypes()
        // Bytes live in chunks/{n} below (Spark plan, no Cloud Storage), or in Storage if ever enabled.
        && ((incoming().get('storageBackend', '') == 'FIRESTORE'
              && incoming().storagePath == 'firestore:organisationDocuments/' + documentId + '/chunks'
              && incoming().chunkCount is int && incoming().chunkCount >= 1 && incoming().chunkCount <= 5)
            || (incoming().get('storageBackend', '') == ''
              && incoming().storagePath.matches('organisation_documents/' + request.auth.uid + '/' + documentId + '/[^/]+')))
        && incoming().mimeType in ['application/pdf', 'image/jpeg', 'image/png']
        && incoming().sizeBytes is int && incoming().sizeBytes > 0 && incoming().sizeBytes <= 3 * 1024 * 1024
        && incoming().verificationStatus == 'PENDING_MANUAL_REVIEW'
        && incoming().reviewedAt == null
        && incoming().reviewedBy == null
        && incoming().reviewNotes == null
        && incoming().uploadedAt == request.time
        && orgEditable(request.auth.uid);
      allow update: if signedIn()
        && existing().ownerUid == request.auth.uid
        && changedKeys().hasOnly(['documentNumber', 'issuingAuthority', 'issuedDate', 'expiryDate'])
        && orgEditable(request.auth.uid);
      allow delete: if signedIn()
        && existing().ownerUid == request.auth.uid
        && orgEditable(request.auth.uid);

      // File bytes (Firestore backend). Same visibility as the metadata: owner + admin only.
      // Written in the same batch as the metadata (getAfter), never updated, deleted with it.
      match /chunks/{chunkId} {
        function parentPath() { return path('organisationDocuments', documentId); }
        allow read: if signedIn() && get(parentPath()).data.ownerUid == request.auth.uid;
        allow create: if signedIn()
          && existsAfter(parentPath())
          && getAfter(parentPath()).data.ownerUid == request.auth.uid
          && incoming().keys().hasOnly(['index', 'data'])
          && incoming().index is int
          && incoming().index >= 0
          && incoming().index < getAfter(parentPath()).data.chunkCount
          && chunkId == string(incoming().index)
          && incoming().data is bytes
          && incoming().data.size() <= 700 * 1024
          && orgEditable(request.auth.uid);
        allow update: if false;
        allow delete: if signedIn()
          && get(parentPath()).data.ownerUid == request.auth.uid
          && orgEditable(request.auth.uid);
      }
    }

    // Append-only audit trail. Admin decisions are written by the Admin SDK. The app may only
    // append its OWN submission / upload records, validated field by field; nobody can edit them.
    match /verificationAuditLogs/{logId} {
      allow read: if false; // admins read via the catch-all admin rule above
      allow create: if signedIn()
        && incoming().keys().hasOnly(['logId', 'organisationId', 'action', 'previousStatus', 'newStatus',
                                      'performedBy', 'performedAt', 'reason', 'notes', 'source'])
        && incoming().logId == logId
        && incoming().organisationId == request.auth.uid
        && incoming().performedBy == request.auth.uid
        && incoming().performedAt == request.time
        && incoming().source == 'APP'
        && incoming().reason == ''
        && incoming().notes is string && incoming().notes.size() <= 200
        && (
          (incoming().action in ['SUBMITTED', 'RESUBMITTED']
            && incoming().previousStatus in allStatuses()
            && incoming().newStatus == 'UNDER_REVIEW'
            && getAfter(path('organisations', request.auth.uid)).data.verificationStatus == 'UNDER_REVIEW')
          || (incoming().action == 'DOCUMENT_UPLOADED'
            && incoming().previousStatus == '' && incoming().newStatus == ''
            && existsAfter(path('organisationDocuments', incoming().notes.split(':')[1])))
        );
      allow update, delete: if false;
    }

    // ═════════════════════════════════════════════════════════════════════════
    // EVENTS
    // Published events: only VERIFIED / OFFICIAL_GOVERNMENT, unexpired, level >= 2 organisations,
    // under their own id and their CURRENT public name / level. Existing event documents stay readable.
    // ═════════════════════════════════════════════════════════════════════════
    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if isOrganisationAccount()
        && incoming().id == eventId
        && incoming().organisationId == request.auth.uid
        && incoming().publishedByUid == request.auth.uid
        && exists(path('organisations', request.auth.uid))
        && orgCanPublishData(get(path('organisations', request.auth.uid)).data)
        && incoming().organisationName == get(path('organisations', request.auth.uid)).data.displayName
        && incoming().organisationVerificationLevel == get(path('organisations', request.auth.uid)).data.verificationLevel
        && incoming().registeredCount == 0
        && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 120;
      allow update: if signedIn()
        && existing().organisationId == request.auth.uid
        && exists(path('organisations', request.auth.uid))
        && orgCanPublishData(get(path('organisations', request.auth.uid)).data)
        && unchanged(['id', 'organisationId', 'organisationName', 'organisationVerificationLevel',
                      'publishedByUid', 'registeredCount', 'createdAt']);
      allow delete: if signedIn() && existing().organisationId == request.auth.uid;
    }

    // Private drafts: any organisation account except a suspended one.
    match /eventDrafts/{draftId} {
      allow read: if signedIn() && resource.data.organisationId == request.auth.uid;
      allow create: if isOrganisationAccount()
        && incoming().id == draftId
        && incoming().organisationId == request.auth.uid
        && orgNotSuspended(request.auth.uid);
      allow update: if isOrganisationAccount()
        && existing().organisationId == request.auth.uid
        && incoming().organisationId == request.auth.uid
        && incoming().id == draftId
        && orgNotSuspended(request.auth.uid);
      allow delete: if signedIn() && existing().organisationId == request.auth.uid;
    }

    // ═════════════════════════════════════════════════════════════════════════
    // COACHES (kept compatible with the current app; status fields are admin-only)
    // ═════════════════════════════════════════════════════════════════════════
    function coachAdminFields() {
      return ['verificationLevel', 'identityStatus', 'qualificationStatus', 'experienceStatus',
              'safeguardingStatus', 'rating', 'reviewCount', 'totalEarnings', 'verifiedAt', 'expiresAt'];
    }
    // Academy links and the directory marker are set only by the admin tool (imported coaches,
    // ids "dircoach-*", no account). A coach account cannot claim them.
    function coachDirectoryFieldsUnchanged() {
      return incoming().get('listingSource', '') == existing().get('listingSource', '')
        && incoming().get('academyIds', []) == existing().get('academyIds', [])
        && incoming().get('academyNames', []) == existing().get('academyNames', []);
    }
    match /coaches/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid)
        && roleAfter(uid) == 'COACH'
        && incoming().uid == uid
        && incoming().get('listingSource', '') == ''
        && incoming().get('academyIds', []).size() == 0
        && incoming().get('academyNames', []).size() == 0
        && incoming().verificationStatus in ['NOT_SUBMITTED', 'PENDING']
        && incoming().get('profileStatus', 'DRAFT') == 'DRAFT'
        && incoming().get('verificationLevel', 'LEVEL_0_REGISTERED') == 'LEVEL_0_REGISTERED'
        && incoming().get('rating', 0) == 0
        && incoming().get('reviewCount', 0) == 0
        && incoming().get('totalEarnings', 0) == 0;
      allow update: if isSelf(uid)
        && unchanged(coachAdminFields().concat(['uid']))
        && coachDirectoryFieldsUnchanged()
        && (unchanged(['verificationStatus'])
            || (existing().verificationStatus in ['NOT_SUBMITTED', 'PENDING', 'ACTION_REQUIRED', 'REJECTED', 'EXPIRED']
                && incoming().verificationStatus == 'UNDER_REVIEW'))
        && (unchanged(['profileStatus'])
            || (existing().get('profileStatus', 'DRAFT') == 'DRAFT' && incoming().profileStatus == 'SUBMITTED')
            || (existing().get('profileStatus', 'DRAFT') == 'ACTIVE' && incoming().profileStatus == 'DEACTIVATED')
            || (existing().get('profileStatus', 'DRAFT') == 'DEACTIVATED' && incoming().profileStatus == 'ACTIVE'
                && existing().verificationStatus == 'VERIFIED'));
      allow delete: if false;

      // Weekly availability range (AvailabilityRules.kt): players' booking slots come from these.
      function validAvailability(d) {
        return d.keys().hasOnly(['availabilityId', 'dayOfWeek', 'enabled', 'startTime', 'endTime', 'createdAt', 'updatedAt'])
          && d.dayOfWeek in ['MONDAY', 'TUESDAY', 'WEDNESDAY', 'THURSDAY', 'FRIDAY', 'SATURDAY', 'SUNDAY']
          && d.enabled is bool
          && d.startTime is string && d.startTime.matches('^[0-2][0-9]:[0-5][0-9]$')
          && d.endTime is string && d.endTime.matches('^[0-2][0-9]:[0-5][0-9]$')
          && d.startTime < d.endTime;
      }

      // qualifications / services / availability: public; references: owner only.
      match /{sub}/{itemId} {
        allow read: if signedIn() && (sub != 'references' || isSelf(uid));
        allow create: if isSelf(uid)
          && (sub != 'availability' || validAvailability(incoming()))
          && incoming().get('verificationStatus', 'NOT_SUBMITTED') in ['NOT_SUBMITTED', 'PENDING']
          && incoming().get('status', 'NOT_SUBMITTED') in ['NOT_SUBMITTED', 'PENDING'];
        allow update: if isSelf(uid)
          && (sub != 'availability' || validAvailability(incoming()))
          && (unchanged(['verificationStatus']) || incoming().verificationStatus in ['NOT_SUBMITTED', 'PENDING'])
          && (unchanged(['status']) || incoming().status in ['NOT_SUBMITTED', 'PENDING'])
          && unchanged(['verifiedAt', 'verifiedBy', 'rejectionReason']);
        allow delete: if isSelf(uid);
      }
    }

    match /coachPrivate/{uid} {
      allow read, create, update: if isSelf(uid);
      allow delete: if false;
    }

    match /coachVerification/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && incoming().get('actionRequiredMessage', '') == (resource == null ? '' : existing().get('actionRequiredMessage', ''))
        && incoming().get('rejectionReason', '') == (resource == null ? '' : existing().get('rejectionReason', ''))
        && incoming().get('reviewedAt', null) == (resource == null ? null : existing().get('reviewedAt', null));
      allow delete: if false;
      match /admin/{doc} {
        allow read, write: if false; // admin-only via Admin SDK
      }
    }

    // ═════════════════════════════════════════════════════════════════════════
    // SESSIONS (bookings) and CHAT
    // ═════════════════════════════════════════════════════════════════════════
    // A booking holds one coach slot. Its id is "{coachId}_{date}_{HHmm}" (SessionPolicy.slotId),
    // so a slot can be held by only one PENDING / CONFIRMED booking. A REJECTED / CANCELLED booking
    // frees the slot: the next booking for it overwrites that document.
    function isPlayerAccount() {
      return signedIn() && exists(path('users', request.auth.uid)) && roleOf(request.auth.uid) == 'PLAYER';
    }
    function validNewBooking(sessionId) {
      let s = incoming();
      let coach = get(path('coaches', s.coachId)).data;
      return isPlayerAccount()
        && s.keys().hasOnly(['id', 'coachId', 'coachName', 'playerId', 'playerName', 'sport', 'date', 'timeSlot',
                             'startTime', 'endTime', 'status', 'price', 'location', 'notes', 'createdAt'])
        && s.id == sessionId
        && s.playerId == request.auth.uid
        && s.coachId != request.auth.uid
        && s.status == 'PENDING'
        && s.date is string && s.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && s.startTime is string && s.startTime.matches('^[0-2][0-9]:[0-5][0-9]$')
        && s.endTime is string && s.endTime.matches('^[0-2][0-9]:[0-5][0-9]$')
        && sessionId == s.coachId + '_' + s.date + '_' + s.startTime.replace(':', '')
        && exists(path('coaches', s.coachId))
        && coach.get('verificationStatus', '') == 'VERIFIED'
        && coach.get('profileStatus', '') == 'ACTIVE'
        && s.coachName == coach.get('name', '')
        && s.price == coach.get('hourlyRate', 0)
        && s.playerName is string && s.playerName.size() <= 60
        && s.get('notes', '') is string && s.get('notes', '').size() <= 300;
    }

    match /sessions/{sessionId} {
      allow read: if signedIn()
        && (resource.data.playerId == request.auth.uid || resource.data.coachId == request.auth.uid);
      allow create: if validNewBooking(sessionId);
      allow update: if
        // Coach: PENDING -> CONFIRMED / REJECTED, CONFIRMED -> COMPLETED / CANCELLED.
        (signedIn() && existing().coachId == request.auth.uid
          && changedKeys().hasOnly(['status'])
          && ((existing().status == 'PENDING' && incoming().status in ['CONFIRMED', 'REJECTED'])
              || (existing().status == 'CONFIRMED' && incoming().status in ['COMPLETED', 'CANCELLED'])))
        // Player: cancel their own pending / confirmed booking.
        || (signedIn() && existing().playerId == request.auth.uid
          && changedKeys().hasOnly(['status'])
          && existing().status in ['PENDING', 'CONFIRMED'] && incoming().status == 'CANCELLED')
        // Anyone (a player) may take a freed slot with a fresh booking.
        || (existing().status in ['REJECTED', 'CANCELLED'] && validNewBooking(sessionId));
      allow delete: if false;
    }

    // ═════════════════════════════════════════════════════════════════════════
    // ACADEMY REQUESTS: a player asks a listed (verified) academy for a session.
    // Readable by the player and the academy's owner account. Imported directory academies have
    // no owner (organisationOwnerUid == ''), so Athlink follows those up via the admin tool.
    // ═════════════════════════════════════════════════════════════════════════
    match /academyRequests/{requestId} {
      function org() { return get(path('organisations', incoming().organisationId)).data; }
      allow read: if signedIn()
        && (resource.data.playerId == request.auth.uid
            || (resource.data.organisationOwnerUid != '' && resource.data.organisationOwnerUid == request.auth.uid));
      allow create: if isPlayerAccount()
        && incoming().keys().hasOnly(['requestId', 'organisationId', 'organisationName', 'organisationLocation',
                                      'organisationOwnerUid', 'coachId', 'coachName', 'playerId', 'playerName', 'sport', 'preferredDate',
                                      'preferredTime', 'message', 'contactPhone', 'status', 'responseNote',
                                      'createdAt', 'updatedAt'])
        && incoming().requestId == requestId
        && incoming().playerId == request.auth.uid
        && exists(path('organisations', incoming().organisationId))
        && orgCanPublishData(org())
        && incoming().organisationName == org().displayName
        && incoming().organisationOwnerUid == org().ownerUid
        && incoming().organisationOwnerUid != request.auth.uid
        && incoming().organisationLocation is string && incoming().organisationLocation.size() <= 150
        && incoming().playerName is string && incoming().playerName.size() <= 60
        && incoming().sport is string && incoming().sport in org().sports
        // Optional coach: must be a bookable coach linked to this academy, for this sport.
        && ((incoming().get('coachId', '') == '' && incoming().get('coachName', '') == '')
            || (exists(path('coaches', incoming().coachId))
              && incoming().organisationId in get(path('coaches', incoming().coachId)).data.get('academyIds', [])
              && incoming().coachName == get(path('coaches', incoming().coachId)).data.name
              && incoming().sport == get(path('coaches', incoming().coachId)).data.sport
              && get(path('coaches', incoming().coachId)).data.get('verificationStatus', '') == 'VERIFIED'
              && get(path('coaches', incoming().coachId)).data.get('profileStatus', '') == 'ACTIVE'))
        && incoming().preferredDate is string && incoming().preferredDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && incoming().preferredTime in ['MORNING', 'AFTERNOON', 'EVENING']
        && incoming().message is string && incoming().message.size() <= 300
        && incoming().contactPhone is string
        && (incoming().contactPhone == '' || incoming().contactPhone.matches('^(\\+91)?[6-9][0-9]{9}$'))
        && incoming().status == 'PENDING'
        && incoming().responseNote == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if signedIn()
        && incoming().updatedAt == request.time
        && (
          // Player withdraws a pending request.
          (existing().playerId == request.auth.uid
            && changedKeys().hasOnly(['status', 'updatedAt'])
            && existing().status == 'PENDING' && incoming().status == 'CANCELLED')
          // Academy owner answers a pending request.
          || (existing().organisationOwnerUid != '' && existing().organisationOwnerUid == request.auth.uid
            && changedKeys().hasOnly(['status', 'responseNote', 'updatedAt'])
            && existing().status == 'PENDING' && incoming().status in ['ACCEPTED', 'DECLINED']
            && incoming().responseNote is string && incoming().responseNote.size() <= 300)
        );
      allow delete: if false;
    }

    // threadId = "{playerUid}_{coachUid}"; only the two participants can read / write.
    match /chats/{threadId}/messages/{messageId} {
      allow read: if signedIn() && request.auth.uid in threadId.split('_');
      allow create: if signedIn()
        && request.auth.uid in threadId.split('_')
        && incoming().senderId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
